<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#1A1A1A">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="32dp"
    android:paddingRight="32dp"
    android:paddingTop="64dp"
    android:paddingBottom="32dp"
    android:background="#1A1A1A">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Claude Pulse"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1. Sign in with your Claude account.\n2. Copy the code the page shows you.\n3. Paste it below and tap Connect."
        android:textColor="#AAAAAA"
        android:textSize="14sp"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="24dp" />

    <!-- Error banner - shown when token is expired/invalid -->
    <LinearLayout
        android:id="@+id/error_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#2A1A1A"
        android:padding="16dp"
        android:layout_marginBottom="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="\u26a0 Signed out"
            android:textColor="#F44336"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your Claude session expired. Sign in again to reconnect the widget."
            android:textColor="#AAAAAA"
            android:textSize="13sp" />
    </LinearLayout>

    <Button
        android:id="@+id/sign_in_button"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Sign in with Claude"
        android:textColor="#6ee7b7"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="#2A2A2A"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/token_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="100dp"
        android:maxLines="6"
        android:scrollbars="vertical"
        android:gravity="top|start"
        android:hint="Paste code here..."
        android:textColorHint="#555555"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:fontFamily="monospace"
        android:background="#2A2A2A"
        android:padding="16dp"
        android:inputType="textMultiLine"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/status_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#AAAAAA"
        android:textSize="13sp"
        android:layout_marginBottom="12dp"
        android:visibility="gone" />

    <Button
        android:id="@+id/connect_button"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Connect"
        android:textColor="#1A1A1A"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="#6ee7b7"
        android:layout_marginBottom="16dp" />


</LinearLayout>

</ScrollView>
